rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Görsel, 5 MB altı (istemci zaten ~100 KB'a sıkıştırıyor)
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile photos collection: /profile_photos/{userId}/{fileName}
    match /profile_photos/{userId}/{fileName} {
      // Profile photos are viewable by any user (students, flatmates, landlords)
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    // İlan fotoğrafları: /listing_photos/{userId}/{fileName}
    // Yükleme için e-posta doğrulaması gerekir (Firestore'daki ilan oluşturma kuralıyla aynı).
    match /listing_photos/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.auth.token.get('email_verified', false) == true
        && isValidImage();
      allow delete: if isOwner(userId);
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
