rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile photos collection: /profile_photos/{userId}/{fileName}
    match /profile_photos/{userId}/{fileName} {
      // Profile photos are viewable by any user (students, flatmates, landlords)
      allow read: if true;
      
      // Only the authenticated account owner or guest upload can write
      // Enforce image content type and max size 5 MB (files are already compressed to < 100 KB on client)
      allow write: if (request.auth != null && request.auth.uid == userId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      // Deletions allowed only by the owner
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
