# Supabase project settings (Project Settings → API in the Supabase dashboard).
# The anon key is safe to expose in the browser; row-level security enforces access control.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Gemini translation runs through the "gemini-proxy" Supabase Edge Function; the API key
# is set as an Edge Function secret (supabase secrets set GEMINI_API_KEY=...), never here.

# (Optional) Cloudinary credentials if choosing Cloudinary instead of Supabase Storage for profile photos
# VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
# VITE_CLOUDINARY_UPLOAD_PRESET="your_upload_preset"
